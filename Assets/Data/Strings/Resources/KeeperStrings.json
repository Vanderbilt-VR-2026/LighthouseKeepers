    {
      "key": "radio.19",
      "text": "Good."
    },
    {
      "key": "radio.20",
      "text": "That will hold."
    },
    {
      "key": "radio.21",
      "text": "There she goes."
    },
    {
      "key": "radio.22",
      "text": "Light is burning."
    },
    {
      "key": "radio.23",
      "text": "Three hours to dawn."
    },
    {
      "key": "radio.24",
      "text": "Two hours to dawn."
    },
    {
      "key": "radio.25",
      "text": "One hour to dawn."
    },
    {
      "key": "radio.26",
      "text": "Almost dawn. Hold on."
    },
    {
      "key": "radio.27",
      "text": "Water is at your knees, keeper."
    },
    {
      "key": "radio.28",
      "text": "It is reaching the generator!"
    },
    {
      "key": "radio.29",
      "text": "You are going under, keeper!"
    },
    {
      "key": "radio.30",
      "text": "Your light is out. There are ships out there!"
    },
    {
      "key": "radio.31",
      "text": "Thirty seconds, keeper!"
    },
    {
      "key": "radio.32",
      "text": "Ten seconds!"
    },
    {
      "key": "radio.33",
      "text": "Hold grip to take the wrench. Bring its head to the bolt, then pull toward you."
    },
    {
      "key": "radio.34",
      "text": "Repair tonight's jobs. Sleep upstairs when they are done."
    },
    {
      "key": "radio.35",
      "text": "Three nights. Keep the light burning and the water down. Bring every ship home."
    },
    {
      "key": "radio.36",
      "text": "Leave the wrench, keeper. Follow the lamps to your next job."
    },
    {
      "key": "radio.37",
      "text": "The pipe needs you. Take the wrench downstairs."
    },
    {
      "key": "radio.38",
      "text": "Next, the generator. Follow the lamps upstairs."
    },
    {
      "key": "radio.39",
      "text": "Head to the radio. Send the storm warning."
    },
    {
      "key": "radio.40",
      "text": "Up to the lantern, keeper. Light it and line up the marks."
    },
    {
      "key": "radio.41",
      "text": "Check the breakers beside the generator."
    },
    {
      "key": "radio.42",
      "text": "Jobs done. Grip your bunk upstairs."
    },
    {
      "key": "radio.43",
      "text": "Follow the hiss, keeper. Take your time with the wrench."
    },
