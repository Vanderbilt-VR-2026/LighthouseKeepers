    },
    {
      "key": "radio.91",
      "text": "That's not it. Try the code again."
    },
    {
      "key": "radio.file.91",
      "text": "keeper_radio_wrong_code"
    },
    {
      "key": "radio.92",
      "text": "Copy, keeper. Warning's out. Good work."
    },
    {
      "key": "radio.file.92",
      "text": "keeper_radio_received"
    },
    {
      "key": "radio.93",
      "text": "That was close, keeper. Too close."
    },
    {
      "key": "radio.file.93",
      "text": "keeper_close_call"
    },
    {
      "key": "radio.94",
      "text": "Fourth night. The sea's angrier than I've ever heard it. Everything's going to go at once."
    },
    {
      "key": "radio.file.94",
      "text": "keeper_night_four"
    },
    {
      "key": "radio.95",
      "text": "Last night, keeper. This is the big one. Hold on till dawn and the boat comes for you."
    },
    {
      "key": "radio.file.95",
      "text": "keeper_night_five"
    },
    {
      "key": "radio.98",
      "text": "She's through. You did it, keeper."
    },
    {
      "key": "radio.file.98",
      "text": "keeper_ship_passed"
    },
    {
      "key": "radio.100",
      "text": "Boat's coming for you at first light. You held the light, keeper. All five nights."
    },
    {
      "key": "radio.file.100",
      "text": "keeper_rescue_dawn"
    },
    {
      "key": "radio.83",
      "text": "Valve slipped! Hold it steady!"
    },
    {
      "key": "radio.file.83",
      "text": "keeper_valve_slipped"
    },
    {
      "key": "radio.96",
      "text": "Ship on the horizon! Keep that light steady."
    },
    {
      "key": "radio.file.96",
      "text": "keeper_ship_sighted"
    },
    {
      "key": "radio.97",
      "text": "She's close to the rocks. Don't you let that light go out."
    },
    {
      "key": "radio.file.97",
      "text": "keeper_ship_close"
    },
    {
      "key": "radio.101",
      "text": "Your partner's in trouble. Get to them!"
    },
    {
      "key": "radio.file.101",
      "text": "keeper_partner_down"
    },
    {
      "key": "radio.99",
      "text": "Oh no... she's on the rocks."
    },
    {
      "key": "radio.file.99",
      "text": "keeper_ship_lost"
    },
